# Development image with nodemon / full deps
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

RUN mkdir -p logs uploads

ENV NODE_ENV=development
ENV PORT=5000

EXPOSE 5000

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]
