# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
APP_NAME=Automated Accounting API
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
MAINTENANCE_MODE=false
API_KEY=change-me-api-key

# =============================================================================
# MongoDB
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/automated_accounting
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=3000
MONGODB_AUTO_INDEX=true

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=aa:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=10
REDIS_ENABLE_OFFLINE_QUEUE=true

# =============================================================================
# JWT
# =============================================================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=automated-accounting
JWT_AUDIENCE=automated-accounting-client

# =============================================================================
# Cookies
# =============================================================================
COOKIE_SECRET=change-me-cookie-secret-min-32-chars-long!!
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
COOKIE_MAX_AGE_MS=604800000
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# =============================================================================
# Bcrypt & Account Security
# =============================================================================
BCRYPT_ROUNDS=12
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000
PASSWORD_RESET_EXPIRES_MS=3600000
EMAIL_VERIFY_EXPIRES_MS=86400000
OTP_LENGTH=6
OTP_EXPIRES_MS=600000

# Seed / create-admin defaults
ADMIN_EMAIL=admin@automatedaccounting.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# =============================================================================
# SMTP / Email
# =============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Automated Accounting
SMTP_FROM_EMAIL=noreply@automatedaccounting.local

# =============================================================================
# Cloudinary
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=automated-accounting
CLOUDINARY_SECURE=true

# =============================================================================
# AWS S3
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=50
RATE_LIMIT_SKIP_SUCCESSFUL=false

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-API-Key,Accept,X-Device-Id,X-Device-Name,X-CSRF-Token
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page,X-Limit,Content-Disposition
CORS_MAX_AGE=86400

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# Uploads / Multer
# =============================================================================
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# =============================================================================
# Swagger
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
SWAGGER_TITLE=Automated Accounting API
SWAGGER_DESCRIPTION=Auth-only REST API for Automated Accounting
SWAGGER_CONTACT_EMAIL=dev@automatedaccounting.local

# =============================================================================
# Pagination defaults
# =============================================================================
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# =============================================================================
# BullMQ / Queues
# =============================================================================
QUEUE_PREFIX=aa-queue
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

# =============================================================================
# Socket.IO
# =============================================================================
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Soft-delete retention (days) before hard purge
SOFT_DELETE_RETENTION_DAYS=30
